    "@types/pg": "^8.18.0",
    "bullmq": "^5.71.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "ioredis": "^5.10.0",
    "multer": "^2.1.1",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "prisma": "^7.5.0",
    "tsx": "^4.19.2",
    "typescript": "*"
  }
}
